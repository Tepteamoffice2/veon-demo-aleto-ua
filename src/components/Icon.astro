---
// Line icons, 1.5px stroke, inline with text (concept §5: no circles behind icons).
interface Props { name: "telegram" | "search" | "menu" | "close" | "pin" | "phone"; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "telegram" && <><path d="M21.2 4.2 2.9 11.3c-.8.3-.8 1.4 0 1.7l4.5 1.6 1.7 5.3c.2.7 1.1.9 1.6.4l2.5-2.4 4.5 3.3c.6.4 1.4.1 1.6-.6l3.2-14.6c.2-.8-.6-1.5-1.3-1.2Z"/><path d="m7.4 14.6 10.1-6.9-7.6 8.4"/></>}
  {name === "search" && <><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></>}
  {name === "menu" && <path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18"/>}
  {name === "pin" && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></>}
  {name === "phone" && <path d="M5 3.5h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.8 6.8l1.4-2.2 4.3 1.7V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z"/>}
</svg>
